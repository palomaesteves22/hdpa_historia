{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back": {
      "root": "back",
      "framework": "express"
    },
    "front": {
      "root": "front",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": { "service": "back" }
    },
    {
      "source": "/busca",
      "destination": { "service": "back" }
    },
    {
      "source": "/busca/(.*)",
      "destination": { "service": "back" }
    },
    {
      "source": "/health",
      "destination": { "service": "back" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "front" }
    }
  ]
}

